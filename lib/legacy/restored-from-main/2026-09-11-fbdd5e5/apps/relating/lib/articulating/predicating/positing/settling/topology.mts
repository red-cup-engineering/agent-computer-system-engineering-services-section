/**
 * settling/topology — the composed relation descent.
 *
 * `induceRelation` is the whole descent with the same domain as `articulate`:
 * articulate → predicate → posit → settle. A relation's identity IS its
 * predication GENERATORS, re-tagged as a settlement filtration; `free` (read)
 * materializes the full settlement. `relateRelations` combines two relations
 * STRUCTURALLY — the union of their generators (an associative monoid) — not by
 * opacifying them into marks and re-descending.
 */
import { articulate, type UtteranceCarrier } from "@lenticule-science/articulating/utterance";
import { presentPredicationSite, predicate, predicateCoincides, type PredicationSite } from "@lenticule-science/articulating/predicating/predication";

/** Induce the relation generated by one utterance — its predication generators,
 *  presented as a settlement filtration (free-able to the full settlement). */
export function induceRelation(carrier: UtteranceCarrier): SettlementFiltrationGenerators {
  if (typeof carrier !== "object" || carrier === null || carrier.kind !== "utterance.carrier") {
    throw new TypeError("induceRelation: expected an utterance carrier");
  }
  const generators = presentPredicationSite(predicate(articulate(carrier)));
  return Object.freeze({
    kind: "predication.settlement.filtration" as const,
    cells: generators.cells,
    specializations: generators.specializations,
  });
}

/** Relate two relations by the UNION of their generators (an associative monoid;
 *  coincident cells dedupe when `free` materializes the cell set). */
export function relateRelations(
  left: SettlementFiltrationGenerators,
  right: SettlementFiltrationGenerators,
): SettlementFiltrationGenerators {
  if (typeof left !== "object" || left === null || left.kind !== "predication.settlement.filtration") {
    throw new TypeError("relateRelations: expected left settlement filtration");
  }
  if (typeof right !== "object" || right === null || right.kind !== "predication.settlement.filtration") {
    throw new TypeError("relateRelations: expected right settlement filtration");
  }
  return Object.freeze({
    kind: "predication.settlement.filtration" as const,
    cells: Object.freeze([...left.cells, ...right.cells]),
    specializations: Object.freeze([...left.specializations, ...right.specializations]),
  });
}

import { freePredicationSite, type PredicationSiteGenerators } from "@lenticule-science/articulating/predicating/predication";
import { utterance, type Mark } from "@lenticule-science/articulating/utterance";
import { settleWith, knowledgeValuationClosureOrder, knowledgeClosureSheaf } from "@lenticule-science/articulating/predicating/positing/settling/valuation-closure";
import { cohomology, type CohomologyCarrier } from "@lenticule-science/articulating/predicating/positing/settling/cohomology";
import type { SettlementFiltration } from "@lenticule-science/articulating/predicating/positing/settling/object";
export function utteranceKnowledgeClosureCohomology(left: Mark, right: Mark): CohomologyCarrier {
  return cohomology(knowledgeClosureSheaf(posit(predicate(articulate(utterance(left, right))))));
}

export interface SettlementFiltrationGenerators {
  readonly kind: "predication.settlement.filtration";
  readonly cells: PredicationSiteGenerators["cells"];
  readonly specializations: PredicationSiteGenerators["specializations"];
}

export function freeSettlementFiltration(generators: SettlementFiltrationGenerators): SettlementFiltration {
  return settle(posit(freePredicationSite({
    kind: "predication.site",
    cells: generators.cells,
    specializations: generators.specializations,
  })));
}

/** Relating settles its auto-witnessed posit in knowledge order. */
export const settle = (carrier: Parameters<typeof settleWith>[0]): SettlementFiltration => settleWith(carrier, knowledgeValuationClosureOrder);

import { meme, composeFibers, fiberCarrier as admittedFiberCarrier, posit as admittedPosit, type FiberCarrier, type Valuation } from "@lenticule-science/articulating/predicating/positing/fiber";
import { witnessedPotential } from "@lenticule-science/articulating/predicating/positing/bilattice-charge";
import type { PositPresheaf } from "@lenticule-science/articulating/predicating/positing/settling/sheaf";

const witnessedValuation = (predication: PredicationSite): Valuation => {
  const valuation = composeFibers(predication.cells.cells.map(cell => meme(cell, witnessedPotential(cell.subject.mark))), predication.base);
  // Relating's wire fibers retain the full entity universe and empty predicates.
  const fibers = predication.cells.predicates.predicates.map(predicate => Object.freeze({
    kind: "predication.fiber.algebra" as const,
    predicate,
    entities: predication.cells.entities,
    assignments: valuation.fibers.find(fiber => predicateCoincides(fiber.predicate, predicate))?.assignments ?? Object.freeze([]),
  }));
  return Object.freeze({ ...valuation, fibers: Object.freeze(fibers) });
};

export const fiberCarrier = (predication: PredicationSite): FiberCarrier => admittedFiberCarrier(predication, witnessedValuation(predication));
export const posit = (predication: PredicationSite): PositPresheaf => admittedPosit(predication, witnessedValuation(predication));

export interface PositPresheafGenerators {
  readonly kind: "predication.posit.presheaf";
  readonly cells: PredicationSiteGenerators["cells"];
  readonly specializations: PredicationSiteGenerators["specializations"];
}

export function presentPositPresheaf(presheafCarrier: PositPresheaf): PositPresheafGenerators {
  const predication = presheafCarrier.fiber.predication;
  return Object.freeze({
    kind: "predication.posit.presheaf" as const,
    cells: predication.cells.cells,
    specializations: predication.specializations,
  });
}

export function freePositPresheaf(generators: PositPresheafGenerators): PositPresheaf {
  return posit(freePredicationSite({
    kind: "predication.site",
    cells: generators.cells,
    specializations: generators.specializations,
  }));
}
