/**
 * The utterance-log descent — animating's settlement of a membrane log into the
 * meme topology over a log of utterances.
 *
 * The boundary settles a whole prehension log at once, so this folds the relating
 * descent over a log rather than a single carrier: articulate each utterance,
 * predicate its potential cell, union the generated predication sites, posit the
 * measured valuation, and settle / read the fixed points. Evidence enters only as
 * utterances; every charge, edge, and section is derived. This is the same
 * `articulate → predicate → posit → settle` traversal the agency descent reads as
 * becoming → doing → working → governing, run here over the membrane's own log.
 */
import {
  articulate,
  predicate,
  predicationSite,
  posit,
  settle,
  fixedPoints,
  fixedPointReadings,
  type UtteranceCarrier,
  type SettlementFiltration,
  type MemeTopologyFixedPointReadings,
} from "@red-cup-engineering/relating";

function requireUtteranceLog(witnesses: readonly UtteranceCarrier[], label: string): void {
  if (witnesses.length === 0) {
    throw new TypeError(`${label}: an empty utterance log founds no settlement`);
  }
  for (const witness of witnesses) {
    if (typeof witness !== "object" || witness === null || witness.kind !== "utterance.carrier") {
      throw new TypeError(`${label}: expected utterance carriers`);
    }
  }
}

/** The topology descent over a log: articulate every utterance, predicate each
 *  potential cell, union the generated predication sites, posit the measured
 *  valuation, and settle. The union lets multiple utterances co-settle into one
 *  relation — the membrane is a single settled individual, not a heap. */
function memeTopologyOf(witnesses: readonly UtteranceCarrier[]): {
  readonly settling: SettlementFiltration;
  readonly fixedPointReadings: MemeTopologyFixedPointReadings;
} {
  const generated = witnesses.map((carrier) => predicate(articulate(carrier)));
  const predicated = predicationSite(
    generated.flatMap((site) => [...site.cells.cells, ...site.specializations]),
  );
  const posited = posit(predicated);
  return {
    settling: settle(posited),
    fixedPointReadings: fixedPointReadings(fixedPoints(posited)),
  };
}

/** The settlement filtration generated by an utterance log. */
export function settleUtterances(witnesses: readonly UtteranceCarrier[]): SettlementFiltration {
  requireUtteranceLog(witnesses, "settleUtterances");
  return memeTopologyOf(witnesses).settling;
}

/** The four fixed-point readings of the meme topology over an utterance log. */
export function fixedPointReadingsOfUtterances(witnesses: readonly UtteranceCarrier[]): MemeTopologyFixedPointReadings {
  requireUtteranceLog(witnesses, "fixedPointReadingsOfUtterances");
  return memeTopologyOf(witnesses).fixedPointReadings;
}
