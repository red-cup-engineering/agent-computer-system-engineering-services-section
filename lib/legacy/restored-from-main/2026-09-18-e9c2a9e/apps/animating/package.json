{
  "name": "@red-cup-engineering/animating",
  "version": "0.2.1",
  "license": "UNLICENSED",
  "type": "module",
  "keywords": [
    "relational-computing",
    "relational-computing-kernel"
  ],
  "description": "Animating is the agency reading of @red-cup-engineering/relating: one descent read as becoming/doing/working/governing and glued into an interior agent. Carriers are single-source JSON-Schema literals registered through Relating's category kernel; actions are Relating actions projected to CLI/OpenAPI/MCP/web with no package-local schema codegen.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp",
    "check": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.scripts.json && chmod +x dist/scripts/*.mjs",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "rebuild": "npm run clean && npm run build",
    "examples": "node examples/agency-descent.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "animate": "./dist/scripts/cli.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@lenticule-science/articulating": "0.2.4",
    "@lenticule-science/communicating": "0.1.0",
    "@lenticule-science/work-science-services-section": "0.1.1",
    "@red-cup-engineering/computer-data-engine": "0.10.0",
    "@red-cup-engineering/knowing": "0.1.1",
    "@red-cup-engineering/playing": "0.1.1",
    "@red-cup-engineering/relating": "0.1.5",
    "@red-cup-engineering/relation-model-notation-json-codec": "0.0.6",
    "@red-cup-engineering/relation-model-notation-typing": "0.0.2",
    "@red-cup-engineering/semantic-content-identify-service": "0.2.8",
    "@red-cup-engineering/sign-communication": "0.2.0",
    "@red-cup-engineering/witness-journal-entry-service": "0.3.0",
    "@red-cup-engineering/witness-journal-log-service": "0.3.0",
    "@ucanto/core": "10.4.6",
    "@ucanto/principal": "9.0.3",
    "@ucanto/validator": "10.0.1"
  },
  "devDependencies": {
    "@red-cup-engineering/witness-journal-state-service": "0.1.2",
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./becoming": {
      "types": "./dist/becoming/index.d.mts",
      "import": "./dist/becoming/index.mjs"
    },
    "./becoming/doing": {
      "types": "./dist/becoming/doing/index.d.mts",
      "import": "./dist/becoming/doing/index.mjs"
    },
    "./becoming/doing/embodying": {
      "types": "./dist/becoming/doing/embodying/index.d.mts",
      "import": "./dist/becoming/doing/embodying/index.mjs"
    },
    "./becoming/doing/working": {
      "types": "./dist/becoming/doing/working/index.d.mts",
      "import": "./dist/becoming/doing/working/index.mjs"
    },
    "./becoming/doing/working/governing": {
      "types": "./dist/becoming/doing/working/governing/index.d.mts",
      "import": "./dist/becoming/doing/working/governing/index.mjs"
    },
    "./writing/captp": {
      "types": "./dist/writing/captp/index.d.mts",
      "import": "./dist/writing/captp/index.mjs"
    },
    "./writing/openai-chat": {
      "types": "./dist/writing/openai-chat/index.d.mts",
      "import": "./dist/writing/openai-chat/index.mjs"
    },
    "./package.json": "./package.json"
  }
}
